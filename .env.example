# Copy to .env (never commit it) and fill in only what you use.

# IndexNow: 8-128 characters of a-z A-Z 0-9 and "-". Publish the same value at https://<host>/<key>.txt
INDEXNOW_KEY=

# Bing Webmaster Tools > Settings > API access
BING_WEBMASTER_API_KEY=

# Path to a Google service-account JSON key (keep the file outside the repository)
GOOGLE_APPLICATION_CREDENTIALS=
